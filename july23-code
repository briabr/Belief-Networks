        columns=[
            "init_w",
            "eps",
            "s_ext",
            "fixedBNat100",
            "name",
            "mean_abs_edge",
            "mean_edge",
        ],
    )
    .groupby(["name"])
    .mean()
    .reset_index(),
    hue="name",
    x="name",
    y="mean_abs_edge",
    palette="plasma",
)
