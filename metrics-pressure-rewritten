from sklearn.preprocessing import StandardScaler
import statsmodels.api as sm
from statsmodels.tools.sm_exceptions import PerfectSeparationError

predictor_vars = [
    "absOm_foc",
    "x_focal",
]
control_vars = []
coef_df = pd.DataFrame()
for eps in eps_values:
    for s in all_pressures:
        for ty in ["rR-C", "R-r"]:

            df = res.query(f"s=={s} and eps=={eps}").copy()

            label_map = dict(zip(response_cols, [np.nan] * len(response_cols)))

            if ty == "R-r":
                label_map["resistant"] = 1
                label_map["resilient"] = 0

            elif ty == "rR-C":
                label_map["resistant"] = 1
                label_map["resilient"] = 1
                label_map["compliant"] = 0
                label_map["latecompliant"] = 0

            df["response_group"] = df["response"].map(label_map)
            df = df.dropna(subset=["response_group"] + predictor_vars + control_vars)
            y = df["response_group"].values
            if len(np.unique(y)) < 2:
                print("Skipping regression: only one outcome category.")
                continue
            print("Observations used:", len(df))
            print("Outcome counts:")
            print(df["response_group"].value_counts())

            X = df[predictor_vars + control_vars]

            predictor_std = X.std()

            print("Predictor variation:")
            print(predictor_std)

            print("\nNumber of unique values:")
            print(X.nunique())

            X = X.loc[:, predictor_std > 1e-6]

            print("\nUnique values in retained predictors:")
            print(X.nunique())

        

            # Check whether any predictors remain
            if X.empty:
                print("Skipping regression: no predictors with variation.")
                continue

            # Standardize the remaining predictors
            scaler = StandardScaler()

            X_scaled_df = pd.DataFrame(
                scaler.fit_transform(X),
                columns=X.columns,
                index=X.index
            )

            try:
                model = sm.Logit(
                    y, sm.add_constant(X_scaled_df)
                ).fit(disp=False, maxiter=100)

            except (np.linalg.LinAlgError, PerfectSeparationError) as e:
                print(f"Skipping regression: {e}")
                continue

            if not model.mle_retvals["converged"]:
                print("Skipping regression: model did not converge.")
                continue

            predictors = X_scaled_df.columns

            confidence_intervals = model.conf_int()

            coefs = pd.DataFrame(
                {
                    "coefficient": model.params.loc[predictors],
                    "odds_ratio": np.exp(model.params.loc[predictors]),
                    "pvalue": model.pvalues.loc[predictors],
                    "ci_low": confidence_intervals.loc[predictors, 0],
                    "ci_high": confidence_intervals.loc[predictors, 1],
                },
                index=predictors
            )

            coefs["type"] = ty
            coefs["s"] = s
            coefs["eps"] = eps

            print(f"\n{ty} --- Intercept: {model.params['const']:.4f}")
            print(f"{ty} --- Pseudo R²:  {model.prsquared:.4f}")  # better than accuracy

            coef_df = pd.concat([coef_df, coefs])

coef_df["metric"] = coef_df.index.map(metric2titleVerb)
