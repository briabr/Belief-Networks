# ----------------------------------------------
# -------    COHENS D
# ----------------------------------------------
def cohens_d(a, b):
    var_a = a.var()
    var_b = b.var()

    n_a = a.count()
    n_b = b.count()

    pooled_var = (
        (n_a - 1) * var_a + (n_b - 1) * var_b
    ) / (n_a + n_b - 2)

    pooled_var[pooled_var < 1e-10] = 0

    with np.errstate(invalid="ignore", divide="ignore"):
        d = (a.mean() - b.mean()) / pooled_var**0.5

    return d.where(pooled_var > 0, other=np.nan)
